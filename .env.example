# Grafana configuration
GF_PLUGINS_PREINSTALL="grafana-github-datasource"
GF_INSTALL_PLUGINS="grafana-github-datasource,yesoreyeram-infinity-datasource"

# Disable Grafana's built-in async plugin preinstall/auto-update. It otherwise
# tries to update the bundled `elasticsearch` plugin into the read-only
# plugins-bundled dir, fails ("permission denied"), and tears the plugin down
# ("plugin not registered"). Does not affect GF_INSTALL_PLUGINS above.
GF_PLUGINS_PREINSTALL_DISABLED="true"

# GitHub datasource configuration (Option 1: PAT)
GITHUB_TOKEN="your_github_token"

# GitHub datasource configuration (Option 2: GitHub App)
GITHUB_APP_ID=""
GITHUB_APP_INSTALL_ID=""
GITHUB_APP_PRIVATE_KEY=""

# DefectDojo configuration
DEFECTDOJO_TOKEN="your_defectdojo_token"

# SonarCloud configuration
SONARCLOUD_TOKEN="your_sonarqube_token"

# Zammad Elasticsearch configuration (separate cluster from ES_HOST above)
ZAMMAD_ES_HOST="your_zammad_elasticsearch_host"
ZAMMAD_ES_PORT="your_zammad_elasticsearch_port"
